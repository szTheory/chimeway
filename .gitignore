# The directory Mix will write compiled artifacts to.
/_build/
chimeway_admin/_build/
chimeway_admin/deps/
chimeway_inbox/_build/
chimeway_inbox/deps/
test/fixtures/apns_consumer/_build/
test/fixtures/apns_consumer/deps/
test/fixtures/apns_consumer/mix.lock

# If you run "mix test --cover", coverage assets end up here.
/cover/

# Test artifacts (e.g. Playwright, JUnit output).
test-results/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
chimeway-*.tar


# ── GSD baseline (auto-generated) ──
.gsd
.gsd-id
.mcp.json
.bg-shell/
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
.claude/
*.code-workspace
.env
.env.*
!.env.example
node_modules/
.next/
dist/
build/
__pycache__/
*.pyc
.venv/
venv/
target/
vendor/
*.log
# Phase 87 observability parser fixtures — intentionally committed .log files
# consumed by test/chimeway/ci_observability_contract_test.exs (OBS-02).
!test/fixtures/ci/*.log
coverage/
.cache/
