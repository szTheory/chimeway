{
  "model_profile": "balanced",
  "commit_docs": true,
  "parallelization": true,
  "search_gitignored": false,
  "brave_search": false,
  "firecrawl": false,
  "exa_search": false,
  "git": {
    "branching_strategy": "none",
    "phase_branch_template": "gsd/phase-{phase}-{slug}",
    "milestone_branch_template": "gsd/{milestone}-{slug}",
    "quick_branch_template": null
  },
  "workflow": {
    "research": true,
    "plan_check": true,
    "verifier": true,
    "nyquist_validation": true,
    "auto_advance": false,
    "node_repair": true,
    "node_repair_budget": 2,
    "ui_phase": true,
    "ui_safety_gate": true,
    "text_mode": false,
    "research_before_questions": true,
    "milestone_assessment": {
      "verify_lib_before_scope": true,
      "adopter_lens_default": true,
      "prefer_repo_inspection_over_docs": true,
      "no_auto_new_milestone": true,
      "flag_doc_impl_drift": true,
      "adoption_evidence_lens": true,
      "run_at_new_milestone": true,
      "consumer_journey_satisfied_at": "v1.6",
      "next_wedge_default": "SEED-003"
    },
    "consumer_journey_proof": {
      "demo_app_path": "examples/chimeway_demo_host",
      "verify_journeys_in_pre_ship": true,
      "prefer_liveview_over_playwright": true
    },
    "discuss_mode": "assumptions",
    "skip_discuss": false,
    "code_review": true,
    "code_review_depth": "standard",
    "_auto_chain_active": false,
    "use_worktrees": false
  },
  "hooks": {
    "context_warnings": true
  },
  "project_code": null,
  "phase_naming": "sequential",
  "agent_skills": {},
  "features": {
    "thinking_partner": false
  },
  "preferences": {
    "vendor_philosophy": "opinionated"
  },
  "resolve_model_ids": "omit",
  "mode": "yolo",
  "granularity": "coarse",
  "runtime": "claude"
}
