{
  "color": {
    "primitive": {
      "$type": "color",
      "$description": "The 15 --cw-* primitive hexes, copied verbatim (lowercase) from the shipped SSOT chimeway_admin/priv/static/chimeway_admin.css. Never edit that file.",
      "ink": { "$value": "#102027" },
      "night": { "$value": "#07131a" },
      "paper": { "$value": "#fffdf8" },
      "porcelain": { "$value": "#f7f4ea" },
      "line": { "$value": "#d8d3c7" },
      "muted": { "$value": "#5e6b72" },
      "teal": { "$value": "#0e7c86" },
      "blue": { "$value": "#2d6cdf" },
      "brass": { "$value": "#d6a84f" },
      "mint": { "$value": "#9adbcf" },
      "violet": { "$value": "#6d5df6" },
      "success": { "$value": "#0b7a50" },
      "warning": { "$value": "#8a5a00" },
      "danger": { "$value": "#b83232" },
      "code": { "$value": "#0b1720" },
      "info": {
        "$value": "{color.primitive.blue}",
        "$description": "Net-new info primitive; aliases the blue primitive rather than a hex literal (D-06 / DIV-2 DOCUMENTED). Mirrors --cw-info: var(--cw-blue)."
      }
    },
    "semantic": {
      "$description": "Two sibling theme groups (D-11). 'system' has no JSON node — it is a CSS-only strategy. Values that equal a primitive hex are alias refs into color.primitive.* (D-10); unique hexes are held directly.",
      "light": {
        "$type": "color",
        "surface-bg": { "$value": "{color.primitive.paper}" },
        "surface-panel": { "$value": "#ffffff" },
        "fg": { "$value": "{color.primitive.ink}" },
        "fg-muted": { "$value": "{color.primitive.muted}" },
        "border": { "$value": "{color.primitive.line}" },
        "accent": { "$value": "{color.primitive.teal}" },
        "focus": {
          "$value": "{focus.ring}",
          "$description": "Mirrors --cw-focus: var(--cw-focus-ring)."
        },
        "surface-hover": { "$value": "#eef8f7" },
        "surface-active": { "$value": "#dff1ef" },
        "control-bg": { "$value": "#ffffff" },
        "control-hover": { "$value": "{color.primitive.porcelain}" },
        "control-active": { "$value": "#eef8f7" },
        "control-disabled-bg": { "$value": "#eee9dc" },
        "control-disabled-fg": { "$value": "#68757b" },
        "border-strong": { "$value": "#a9bebf" },
        "focus-halo": { "$value": "#dbe9ff" },
        "button-primary-bg": { "$value": "{color.primitive.teal}" },
        "button-primary-fg": { "$value": "#ffffff" },
        "button-danger-bg": { "$value": "{color.primitive.danger}" },
        "button-danger-fg": { "$value": "#ffffff" },
        "table-row-hover": { "$value": "#f4faf9" },
        "row-bg": { "$value": "{color.primitive.porcelain}" },
        "row-hover": { "$value": "#eef8f7" },
        "link-fg": { "$value": "#0e5f67" },
        "status": {
          "success": {
            "text": { "$value": "#0b6b47" },
            "surface": { "$value": "#e8f6ef" },
            "border": { "$value": "#9fd8bf" }
          },
          "warning": {
            "text": { "$value": "#765000" },
            "surface": { "$value": "#fff2cf" },
            "border": { "$value": "#e5c36d" }
          },
          "danger": {
            "text": { "$value": "#9f2424" },
            "surface": { "$value": "#fdecec" },
            "border": { "$value": "#eda3a3" }
          },
          "info": {
            "text": { "$value": "#0e5f67" },
            "surface": { "$value": "#e8f6f5" },
            "border": { "$value": "#94d4d7" }
          },
          "neutral": {
            "text": { "$value": "#425158" },
            "surface": { "$value": "#f1eee4" },
            "border": { "$value": "{color.primitive.line}" }
          }
        }
      },
      "dark": {
        "$type": "color",
        "surface-bg": { "$value": "{color.primitive.night}" },
        "surface-panel": { "$value": "#10232c" },
        "fg": { "$value": "{color.primitive.paper}" },
        "fg-muted": { "$value": "#b8c5c9" },
        "border": { "$value": "#29414a" },
        "accent": { "$value": "{color.primitive.mint}" },
        "focus": { "$value": "{color.primitive.brass}" },
        "surface-hover": { "$value": "#17323b" },
        "surface-active": { "$value": "#20434c" },
        "control-bg": { "$value": "#10232c" },
        "control-hover": { "$value": "#17323b" },
        "control-active": { "$value": "#20434c" },
        "control-disabled-bg": { "$value": "#13242b" },
        "control-disabled-fg": { "$value": "#7f9298" },
        "border-strong": { "$value": "#4b6972" },
        "focus-halo": { "$value": "#34280d" },
        "button-primary-bg": { "$value": "{color.primitive.mint}" },
        "button-primary-fg": { "$value": "{color.primitive.night}" },
        "button-danger-bg": { "$value": "#ffb3b3" },
        "button-danger-fg": { "$value": "{color.primitive.night}" },
        "table-row-hover": { "$value": "#112832" },
        "row-bg": { "$value": "#0b1b23" },
        "row-hover": { "$value": "#17323b" },
        "link-fg": { "$value": "{color.primitive.mint}" },
        "status": {
          "success": {
            "text": { "$value": "#b7f0d7" },
            "surface": { "$value": "#0d2f24" },
            "border": { "$value": "#2d7a5d" }
          },
          "warning": {
            "text": { "$value": "#ffe0a0" },
            "surface": { "$value": "#33260b" },
            "border": { "$value": "#8a6824" }
          },
          "danger": {
            "text": { "$value": "#ffd4d4" },
            "surface": { "$value": "#3a1717" },
            "border": { "$value": "#984747" }
          },
          "info": {
            "text": { "$value": "#b8eee8" },
            "surface": { "$value": "#0d3035" },
            "border": { "$value": "#397b83" }
          },
          "neutral": {
            "text": { "$value": "#d5dee1" },
            "surface": { "$value": "#142832" },
            "border": { "$value": "#4b6972" }
          }
        }
      }
    }
  },
  "space": {
    "$type": "dimension",
    "xs": { "$value": { "value": 4, "unit": "px" } },
    "sm": { "$value": { "value": 8, "unit": "px" } },
    "md": { "$value": { "value": 16, "unit": "px" } },
    "lg": { "$value": { "value": 24, "unit": "px" } },
    "xl": { "$value": { "value": 32, "unit": "px" } },
    "2xl": { "$value": { "value": 48, "unit": "px" } },
    "3xl": { "$value": { "value": 64, "unit": "px" } }
  },
  "type": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter", "ui-sans-serif", "system-ui", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "sans-serif"]
      },
      "mono": {
        "$value": ["IBM Plex Mono", "ui-monospace", "SFMono-Regular", "Menlo", "Monaco", "Consolas", "monospace"]
      }
    },
    "size": {
      "$type": "dimension",
      "label": { "$value": { "value": 14, "unit": "px" } },
      "body": { "$value": { "value": 16, "unit": "px" } },
      "heading": { "$value": { "value": 20, "unit": "px" } },
      "display": { "$value": { "value": 28, "unit": "px" } }
    },
    "lineHeight": {
      "$type": "number",
      "label": { "$value": 1.35 },
      "body": { "$value": 1.5 },
      "heading": { "$value": 1.2 },
      "display": { "$value": 1.15 }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "semibold": { "$value": 600 }
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": { "value": 5, "unit": "px" },
      "$description": "Shipped value is 5px verbatim; the brand-book 4px is DEFERRED (DIV-1), not patched here."
    },
    "md": { "$value": { "value": 8, "unit": "px" } },
    "pill": { "$value": { "value": 999, "unit": "px" } }
  },
  "border": {
    "$type": "dimension",
    "width": {
      "$value": { "value": 1, "unit": "px" },
      "$description": "Net-new default satisfying the border family (DIV-7 DOCUMENTED). Mirrors --cw-border-width: 1px. Border color aliases live in color.semantic.*."
    }
  },
  "shadow": {
    "panel": {
      "$type": "shadow",
      "$value": {
        "color": "rgb(16 32 39 / 0.08)",
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 16, "unit": "px" },
        "blur": { "value": 42, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      },
      "$description": "Light-theme panel elevation (--cw-shadow-panel: 0 16px 42px rgb(16 32 39 / 0.08)). Dark elevation (0 18px 50px rgb(0 0 0 / 0.35)) is a CSS theming concern, not a JSON sibling — D-11 splits only color.semantic into light/dark."
    }
  },
  "focus": {
    "ring": {
      "$type": "color",
      "$value": "{color.primitive.blue}",
      "$description": "Mirrors --cw-focus-ring: var(--cw-blue)."
    },
    "offset": {
      "$type": "dimension",
      "$value": { "value": 3, "unit": "px" }
    }
  },
  "z": {
    "$type": "number",
    "sidebar": { "$value": 10 },
    "focus": {
      "$value": 50,
      "$description": "Shipped z-index scale, verbatim (DIV-6 DOCUMENTED)."
    }
  },
  "motion": {
    "$type": "duration",
    "fast": {
      "$value": { "value": 120, "unit": "ms" },
      "$description": "Mirrors --cw-motion-fast: 120ms ease-out. DTCG emits the duration only; the ease-out easing is preserved in the CSS shorthand (DIV-5 DOCUMENTED; easing not hard-coded as a cubicBezier — RESEARCH Open Q2)."
    },
    "pressed": {
      "$value": { "value": 80, "unit": "ms" },
      "$description": "Mirrors --cw-motion-pressed: 80ms ease-out. Duration-only; ease-out preserved in the CSS shorthand (DIV-5 DOCUMENTED)."
    }
  }
}
